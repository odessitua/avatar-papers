arxiv:
  max_results_per_topic: 200
  sort_by: "submitted"       # "submitted" or "updated"
  search_field: "abs"        # "ti" (title), "abs" (abstract), "all" (all fields)
  # Lower bound for submittedDate (YYYY-MM-DD). Backfill older quarters with --date-from/--date-to.
  date_from: "2025-01-01"
  # date_to: "2026-12-31"    # optional; omit for open-ended range (newest submissions)
  categories:
    - "cs.SE"
    - "cs.AI"
    - "cs.CL"
    - "cs.HC"
    - "cs.GR"
    - "cs.CV"
    - "cs.MM"

# Group order is priority when a paper matches more than one group.
# Process groups come before feature groups; the broadest group in each family is last.
keywords:
  coding_agents:
    - "coding agent"
    - "agentic coding"
    - "software engineering agent"
    - "SWE-bench"
    - "issue resolution"
    - "repository-level code generation"
  spec_review_verify:
    - "code review agent"
    - "test generation agent"
    - "specification-driven development"
    - "requirements to code"
    - "software verification agent"
  repo_context:
    - "repository context"
    - "codebase understanding"
    - "context engineering"
    - "retrieval-augmented code generation"
  human_ai_workflow:
    - "AI-assisted programming"
    - "AI pair programming"
    - "human-AI programming"
    - "vibe coding"
  chart_generation:
    - "text-to-visualization"
    - "natural language to visualization"
    - "chart generation"
    - "visualization generation"
    - "data video"
  text_motion:
    - "kinetic typography"
    - "text animation"
    - "animated text"
    - "motion graphics generation"
  screen_video:
    - "screen recording"
    - "screencast"
    - "tutorial video generation"
    - "presentation video generation"
    - "demo video generation"
  gui_agents:
    - "GUI agent"
    - "computer-use agent"
    - "web agent"
    - "GUI grounding"

paths:
  csv_file: "data/papers.csv"
  db_file: "data/papers.db"
  publish_state: "data/publish_state.json"
  originals_dir: "papers/originals"
  analysis_dir: "papers/analysis"
  analysis_ru_dir: "papers/analysis_ru"
  figures_dir: "papers/figures"

code_search:
  enabled: true
  delay: 6.5   # seconds between GitHub Search API requests (rate limit)

download:
  delay: 3.0
  timeout: 120

openrouter:
  base_url: "https://openrouter.ai/api/v1"
  model: "openai/gpt-6-luna"
  # translate_model: "openai/gpt-6-luna"  # defaults to model if omitted

llm:
  provider: "openrouter"  # switch to "bedrock" to use AWS credentials
  max_tokens: 8000
  temperature: 0.3
  reasoning_effort: "medium"  # none, low, medium, high, xhigh, max
  pdf_max_chars: 120000

bedrock:
  model_id: "us.openai.gpt-6-luna"
  region: "us-east-2"

confluence:
  space_key: "YOUR_SPACE_KEY"
  parent_page_id: "YOUR_PARENT_PAGE_ID"
  papers_page_title: "Papers AI Development"
  ru_page_title: "RU · AI Dev"
  prompt_page_title: "Analysis Prompt · AI Dev"
  keywords_page_title: "Search Keywords · AI Dev"
  title_marker: "AI Dev"
